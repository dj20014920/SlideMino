+    private void removeCurrentAdViewFromHierarchy() {
+        if (mAdView == null) {
+            return;
+        }
+
+        try {
+            if (mAdViewLayout != null) {
+                mViewGroup.removeView(mAdViewLayout);
+                mAdViewLayout.removeView(mAdView);
+            }
+            mAdView.destroy();
+        } catch (Exception ignored) {
+            // Cleanup is best-effort after a failed view construction path.
+        } finally {
+            mAdView = null;
+            mAdViewLayout = null;
+        }
+    }
+
+    private void applyBannerLayoutGravity(CoordinatorLayout.LayoutParams layoutParams, String position) {
+        switch (position) {
+            case "TOP_CENTER":
+                layoutParams.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL;
+                break;
+            case "CENTER":
+                layoutParams.gravity = Gravity.CENTER;
+                break;
+            default:
+                layoutParams.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL;
+                break;
+        }
+    }
+
+    private int calculateHorizontalMarginPx(
+        AdOptions adOptions,
+        float density,
+        int defaultWidthPixels,
+        int realWidthPixels,
+        boolean fullscreen
+    ) {
+        int adWidth = (int) (adOptions.adSize.getSize().getWidth() * density);
+
+        if (adWidth <= 0 || adOptions.adSize.toString().equals("ADAPTIVE_BANNER")) {
+            if (fullscreen) {
+                return Math.max(0, (realWidthPixels - defaultWidthPixels) / 2);
+            }
+            return 0;
+        }
+
+        if (fullscreen) {
+            return Math.max(0, (realWidthPixels - adWidth) / 2);
+        }
+
+        return Math.max(0, (defaultWidthPixels - adWidth) / 2);
+    }
+
+    private void applyBannerLayoutMargins(
+        CoordinatorLayout.LayoutParams layoutParams,
+        String position,
+        int horizontalMarginPx,
+        int verticalMarginPx,
+        int insetLeftPx,
+        int insetTopPx,
+        int insetRightPx,
+        int insetBottomPx
+    ) {
+        int leftMargin = horizontalMarginPx + insetLeftPx;
+        int rightMargin = horizontalMarginPx + insetRightPx;
+
+        switch (position) {
+            case "TOP_CENTER":
+                layoutParams.setMargins(leftMargin, verticalMarginPx + insetTopPx, rightMargin, 0);
+                break;
+            case "CENTER":
+                layoutParams.setMargins(leftMargin, verticalMarginPx, rightMargin, verticalMarginPx);
+                break;
+            default:
+                layoutParams.setMargins(leftMargin, 0, rightMargin, verticalMarginPx + insetBottomPx);
+                break;
+        }
+    }
